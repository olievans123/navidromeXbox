<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:NavidromeXbox.Helpers">

    <!-- ============ Shared value converters ============ -->
    <helpers:DurationConverter x:Key="DurationConverter" />
    <helpers:StarGlyphConverter x:Key="StarGlyphConverter" />
    <helpers:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter" />
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- ============ Palette ============ -->
    <!-- Deep "midnight studio" violet with an electric cyan accent. -->
    <Color x:Key="AppBackgroundColor">#0E0B16</Color>
    <Color x:Key="AppSurfaceColor">#181226</Color>
    <Color x:Key="AppSurfaceHighColor">#241A38</Color>
    <Color x:Key="AccentColor">#19D3C5</Color>
    <Color x:Key="AccentLightColor">#5BF0E4</Color>
    <Color x:Key="AccentMagentaColor">#C45CFF</Color>
    <Color x:Key="TextPrimaryColor">#F3F0FA</Color>
    <Color x:Key="TextSecondaryColor">#A39DBA</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceHighBrush" Color="{StaticResource AppSurfaceHighColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="AccentMagentaBrush" Color="{StaticResource AccentMagentaColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7A8C" />
    <SolidColorBrush x:Key="LiveBrush" Color="#E0463A" />

    <!-- Green the "on" state of every ToggleSwitch to the app's cyan accent -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="{StaticResource AccentLightColor}" />

    <!-- Hero gradient used behind the home / login screens -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A1030" Offset="0.0" />
        <GradientStop Color="#0E0B16" Offset="0.55" />
        <GradientStop Color="#06181C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0.0" />
        <GradientStop Color="{StaticResource AccentMagentaColor}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ============ Type ramp (tuned for 10ft viewing) ============ -->
    <x:Double x:Key="DisplaySize">64</x:Double>
    <x:Double x:Key="TitleSize">36</x:Double>
    <x:Double x:Key="SubtitleSize">24</x:Double>
    <x:Double x:Key="BodySize">20</x:Double>
    <x:Double x:Key="CaptionSize">16</x:Double>

    <!-- ============ Card style ============ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
    </Style>

    <!-- ============ Big focusable menu/action button ============ -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AppSurfaceHighBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="28,22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" />
                        <Border x:Name="HoverTint" CornerRadius="16" Opacity="0">
                            <Border.Background>
                                <SolidColorBrush Color="#FFFFFF" Opacity="0.10" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="16" Opacity="0" BorderThickness="3">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{StaticResource AccentLightColor}" />
                            </Border.BorderBrush>
                        </Border>
                        <ContentPresenter x:Name="Content"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="HoverTint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary call-to-action button (cyan, filled) -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#06201E" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Compact navigation-pane button so the full menu fits without being cut off -->
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource TileButton}">
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Round/compact icon button (e.g. transport / nav hamburger). No default-button
         gray: constant fill, a white sheen on press, and the cyan focus ring. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border x:Name="Sheen" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Opacity="0">
                            <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.12" /></Border.Background>
                        </Border>
                        <Border x:Name="Ring" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="2.5" IsHitTestVisible="False" Opacity="0">
                            <Border.BorderBrush><SolidColorBrush Color="{StaticResource AccentLightColor}" /></Border.BorderBrush>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.10" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Sheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.10" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round transport button (big circular play/pause etc.) -->
    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceHighBrush}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Combo boxes get the cyan focus ring to match the rest of the app -->
    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource AccentLightBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="#99000000" />
    </Style>

    <!-- List item containers get the SAME rounded cyan focus ring as the tiles. -->
    <Style TargetType="ListViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid Background="Transparent">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border x:Name="Tint" CornerRadius="12" IsHitTestVisible="False" Opacity="0">
                            <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.08" /></Border.Background>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="12" BorderThickness="3" IsHitTestVisible="False" Opacity="0">
                            <Border.BorderBrush><SolidColorBrush Color="{StaticResource AccentLightColor}" /></Border.BorderBrush>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewItem">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border x:Name="Tint" CornerRadius="16" IsHitTestVisible="False" Opacity="0">
                            <Border.Background><SolidColorBrush Color="#FFFFFF" Opacity="0.08" /></Border.Background>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="16" BorderThickness="3" IsHitTestVisible="False" Opacity="0">
                            <Border.BorderBrush><SolidColorBrush Color="{StaticResource AccentLightColor}" /></Border.BorderBrush>
                        </Border>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Tint" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedUnfocused">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="SelectedPointerOver">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0" /></Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="FocusRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Shared item templates ============ -->

    <!-- Album cover tile (used in grids on Home / Albums / Artist / Search) -->
    <DataTemplate x:Key="AlbumTileTemplate">
        <StackPanel Width="200" Margin="0,0,0,6">
            <Border Width="200" Height="200" CornerRadius="12" Background="{StaticResource AppSurfaceHighBrush}">
                <Grid>
                    <TextBlock Text="&#xE93C;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CoverArtUri}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource BodySize}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxLines="1" Margin="2,8,2,0" />
            <TextBlock Text="{Binding ArtistName}" FontSize="{StaticResource CaptionSize}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxLines="1" Margin="2,0,2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Artist tile (round cover) -->
    <DataTemplate x:Key="ArtistTileTemplate">
        <StackPanel Width="190" Margin="0,0,0,6" HorizontalAlignment="Center">
            <Border Width="170" Height="170" CornerRadius="85" Background="{StaticResource AppSurfaceHighBrush}" HorizontalAlignment="Center">
                <Grid>
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CoverArtUri}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource BodySize}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxLines="1" TextAlignment="Center" Margin="2,8,2,0" />
            <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource CaptionSize}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="2,0,2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Playlist tile -->
    <DataTemplate x:Key="PlaylistTileTemplate">
        <StackPanel Width="220" Margin="0,0,0,6">
            <Border Width="220" Height="220" CornerRadius="12" Background="{StaticResource AppSurfaceHighBrush}">
                <Grid>
                    <TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="48"
                               Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding CoverArtUri}" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Name}" FontSize="{StaticResource BodySize}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxLines="1" Margin="2,8,2,0" />
            <TextBlock Text="{Binding Meta}" FontSize="{StaticResource CaptionSize}"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       MaxLines="1" Margin="2,0,2,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Song row (used in album / playlist / queue / search lists) -->
    <DataTemplate x:Key="SongRowTemplate">
        <Grid Padding="14,10" ColumnSpacing="16" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TrackText}" VerticalAlignment="Center" TextAlignment="Center"
                       FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="{StaticResource BodySize}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding ArtistName}" FontSize="{StaticResource CaptionSize}"
                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Starred, Converter={StaticResource StarGlyphConverter}}"
                       FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentMagentaBrush}" Margin="0,0,4,0" />
            <TextBlock Grid.Column="3" Text="{Binding DurationText}" VerticalAlignment="Center"
                       FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
    </DataTemplate>

    <!-- Genre tile -->
    <DataTemplate x:Key="GenreTileTemplate">
        <Border Width="240" Height="120" CornerRadius="14" Margin="0,0,0,6" Padding="18"
                Background="{StaticResource AppSurfaceHighBrush}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource CaptionSize}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
