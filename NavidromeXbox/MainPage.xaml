<Page
    x:Class="NavidromeXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NavidromeXbox.Controls">

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <StaticResource ResourceKey="HeroGradientBrush" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Collapsible navigation. Hidden by default so content gets full width; the
             hamburger and the gamepad Menu button reveal it. -->
        <SplitView x:Name="NavSplit" Grid.Row="0" DisplayMode="Overlay" OpenPaneLength="260"
                   IsPaneOpen="False" PaneBackground="{StaticResource AppSurfaceBrush}">
            <SplitView.Pane>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavItems" Padding="12,16,12,16" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,2,6,10">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#06201E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Navidrome" FontSize="{StaticResource BodySize}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="for Xbox" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Tag="home" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Home" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AlbumsNav" Style="{StaticResource NavButton}" Tag="albums" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE93C;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Albums" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ArtistsNav" Style="{StaticResource NavButton}" Tag="artists" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Artists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PlaylistsNav" Style="{StaticResource NavButton}" Tag="playlists" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Playlists" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GenresNav" Style="{StaticResource NavButton}" Tag="genres" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Genres" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RadioNav" Style="{StaticResource NavButton}" Tag="radio" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Radio" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SearchNav" Style="{StaticResource NavButton}" Tag="search" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Search" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NowPlayingNav" Style="{StaticResource NavButton}" Tag="nowplaying" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Now Playing" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="8,8,8,8" />

                        <Button x:Name="QueueNav" Style="{StaticResource NavButton}" Tag="queue" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE90B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Queue" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="settings" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="22" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <!-- Content fills the width; the hamburger floats in the top-left margin so it
                 reserves no gutter and pages run edge-to-edge (within their own padding). -->
            <Grid>
                <Frame x:Name="ContentFrame" />

                <Button x:Name="MenuButton" Click="ToggleNav_Click"
                        Style="{StaticResource IconButton}"
                        VerticalAlignment="Top" HorizontalAlignment="Left"
                        Width="44" Height="44" Margin="8,12,0,0" CornerRadius="22"
                        Background="#59000000" FontSize="20"
                        Content="&#xE700;" ToolTipService.ToolTip="Menu (View button)" />
            </Grid>
        </SplitView>

        <!-- Persistent mini player docked across the bottom -->
        <controls:NowPlayingBar x:Name="MiniPlayer" Grid.Row="1" />
    </Grid>
</Page>
