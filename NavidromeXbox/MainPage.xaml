<Page
    x:Class="NavidromeXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NavidromeXbox.Controls">

    <Grid>
        <Grid.Background>
            <StaticResource ResourceKey="HeroGradientBrush" />
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Collapsible navigation. Hidden by default so content gets full width; the
             hamburger and the gamepad Menu button reveal it. -->
        <SplitView x:Name="NavSplit" Grid.Row="0" DisplayMode="Overlay" OpenPaneLength="260"
                   IsPaneOpen="False" PaneBackground="{StaticResource AppSurfaceBrush}">
            <SplitView.Pane>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavItems" Padding="12,16,12,16" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,2,6,10">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#06201E"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Navidrome" FontSize="{StaticResource BodySize}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="for Xbox" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Tag="home" Click="Nav_Click" Content="&#xE80F;   Home" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="albums" Click="Nav_Click" Content="&#xE93C;   Albums" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="artists" Click="Nav_Click" Content="&#xE77B;   Artists" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="playlists" Click="Nav_Click" Content="&#xE90B;   Playlists" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="genres" Click="Nav_Click" Content="&#xE8EC;   Genres" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="search" Click="Nav_Click" Content="&#xE721;   Search" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="nowplaying" Click="Nav_Click" Content="&#xE768;   Now Playing" FontFamily="Segoe MDL2 Assets" />

                        <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="8,8,8,8" />

                        <Button Style="{StaticResource NavButton}" Tag="queue" Click="Nav_Click" Content="&#xE90B;   Queue" FontFamily="Segoe MDL2 Assets" />
                        <Button Style="{StaticResource NavButton}" Tag="settings" Click="Nav_Click" Content="&#xE713;   Settings" FontFamily="Segoe MDL2 Assets" />
                    </StackPanel>
                </ScrollViewer>
            </SplitView.Pane>

            <!-- Content: a slim gutter holds the hamburger so it never overlaps a page title. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="MenuButton" Grid.Column="0" Click="ToggleNav_Click"
                        Style="{StaticResource IconButton}"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Width="44" Height="44" Margin="0,12,0,0" CornerRadius="22"
                        Background="#59000000" FontSize="20"
                        Content="&#xE700;" ToolTipService.ToolTip="Menu (Menu button)" />

                <Frame x:Name="ContentFrame" Grid.Column="1" />
            </Grid>
        </SplitView>

        <!-- Persistent mini player docked across the bottom -->
        <controls:NowPlayingBar x:Name="MiniPlayer" Grid.Row="1" />
    </Grid>
</Page>
