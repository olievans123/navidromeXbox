<Page
    x:Class="NavidromeXbox.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="80,48">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,20,0,8">
                    <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#06201E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock Text="Connect to Navidrome" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Sign in to your Navidrome (or any Subsonic-compatible) server."
                           FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,18" />

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Server address" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="ServerBox" PlaceholderText="https://music.example.com"
                                     FontSize="{StaticResource BodySize}" InputScope="Url" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Username" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="UserBox" FontSize="{StaticResource BodySize}" />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Password" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <PasswordBox x:Name="PassBox" FontSize="{StaticResource BodySize}" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                   FontSize="{StaticResource CaptionSize}" Visibility="Collapsed" />

                        <Grid>
                            <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Connect"
                                    HorizontalAlignment="Stretch" Click="Connect_Click" />
                            <ProgressRing x:Name="Busy" Width="28" Height="28" IsActive="False"
                                          Foreground="#06201E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Your password is stored securely in the Windows credential vault and is only used to sign each request — it is never sent over the wire."
                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="12,16,12,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
