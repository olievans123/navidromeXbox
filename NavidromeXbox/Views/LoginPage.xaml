<Page
    x:Class="NavidromeXbox.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="4">

                <!-- Logo + title on one row to keep the form short enough to fit without scrolling. -->
                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,4,0,12">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource AccentGradientBrush}">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#06201E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Connect to Navidrome" FontSize="{StaticResource SubtitleSize}" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Sign in to your Navidrome or Subsonic-compatible server."
                                   FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource CardBorder}" Padding="22">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Server address" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="ServerBox" PlaceholderText="https://music.example.com"
                                     FontSize="{StaticResource BodySize}" InputScope="Url" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Username" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox x:Name="UserBox" FontSize="{StaticResource BodySize}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Password" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <PasswordBox x:Name="PassBox" FontSize="{StaticResource BodySize}" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                   FontSize="{StaticResource CaptionSize}" Visibility="Collapsed" />

                        <Grid Margin="0,4,0,0">
                            <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Content="Connect"
                                    HorizontalAlignment="Stretch" Click="Connect_Click" />
                            <ProgressRing x:Name="Busy" Width="28" Height="28" IsActive="False"
                                          Foreground="#06201E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Your password is kept in the Windows credential vault and only used to sign each request — it is never sent over the wire."
                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="12,10,12,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
