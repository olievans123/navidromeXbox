<Page
    x:Class="NavidromeXbox.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <!-- A settings row: label on the left, control on the right, never overlapping. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
    </Page.Resources>

    <Grid Padding="56,28,40,16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="820" Spacing="18">
                <TextBlock Text="Settings" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <!-- Account -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Connection" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ServerText" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock x:Name="UserText" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Playback -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Streaming &amp; playback" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Maximum bitrate" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Lower this on slower connections; the server transcodes on the fly." TextWrapping="Wrap"
                                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="BitrateBox" VerticalAlignment="Center" MinWidth="200"
                                      Style="{StaticResource ThemedComboBox}" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Original (no limit)" Tag="0" />
                                <ComboBoxItem Content="320 kbps" Tag="320" />
                                <ComboBoxItem Content="256 kbps" Tag="256" />
                                <ComboBoxItem Content="192 kbps" Tag="192" />
                                <ComboBoxItem Content="128 kbps" Tag="128" />
                                <ComboBoxItem Content="96 kbps" Tag="96" />
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Transcode format" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Leave on Original unless a codec won't play." TextWrapping="Wrap"
                                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="FormatBox" VerticalAlignment="Center" MinWidth="200"
                                      Style="{StaticResource ThemedComboBox}" SelectionChanged="Setting_Changed">
                                <ComboBoxItem Content="Original" Tag="raw" />
                                <ComboBoxItem Content="MP3" Tag="mp3" />
                                <ComboBoxItem Content="Opus" Tag="opus" />
                                <ComboBoxItem Content="AAC" Tag="aac" />
                            </ComboBox>
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Scrobble plays" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Report listens back to Navidrome (and any connected Last.fm / ListenBrainz)." TextWrapping="Wrap"
                                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" x:Name="ScrobbleToggle" VerticalAlignment="Center" Toggled="Setting_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Home screen layout -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Home screen" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose which shelves appear on Home." FontSize="{StaticResource CaptionSize}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recently added" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="HomeNewestToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Recently played" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="HomeRecentToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Most played" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="HomeFrequentToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Random picks" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="HomeRandomToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Starred albums" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="HomeStarredToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Navigation menu layout -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Navigation menu" FontSize="{StaticResource SubtitleSize}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Choose which sections appear in the side menu. Home, Now Playing, Queue, and Settings always stay."
                                   TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Albums" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="NavAlbumsToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Artists" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="NavArtistsToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Playlists" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="NavPlaylistsToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Genres" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="NavGenresToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Radio" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="NavRadioToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center"
                                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextPrimaryBrush}" />
                            <ToggleSwitch Grid.Column="1" x:Name="NavSearchToggle" VerticalAlignment="Center" Toggled="Layout_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="SignOutButton" Style="{StaticResource TileButton}" Click="SignOut_Click"
                        HorizontalContentAlignment="Center" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,24">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xF3B1;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                        <TextBlock Text="Sign out" FontFamily="Segoe UI" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <TextBlock Text="Navidrome for Xbox — a native Subsonic/OpenSubsonic client."
                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
