<Page
    x:Class="NavidromeXbox.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="56,28,40,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Playlists" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <GridView x:Name="Grid" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Playlist_Click"
                      ItemTemplate="{StaticResource PlaylistTileTemplate}" />
        </ScrollViewer>

        <ProgressRing x:Name="Busy" Grid.Row="1" Width="44" Height="44" IsActive="True"
                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Text="No playlists yet." Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="{StaticResource BodySize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" TextAlignment="Center" Margin="40" />
    </Grid>
</Page>
