<Page
    x:Class="NavidromeXbox.Views.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="56,24,56,24">
        <!-- A row-based Grid (NOT a centred StackPanel): the art lives in a flexible * row that
             shrinks to whatever height is left, so the title/seek/controls in the Auto rows below
             are ALWAYS on screen — it can't overflow and clip the controls regardless of the
             effective resolution. -->
        <Grid x:Name="PlayerRoot" MaxWidth="620" HorizontalAlignment="Center" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Album art: capped at 460, but scaled DOWN by the Viewbox to fit the leftover row
                 height so it never pushes the controls off a short screen. -->
            <Viewbox Grid.Row="0" StretchDirection="DownOnly" MaxHeight="460" Margin="0,0,0,18"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="460" Height="460" CornerRadius="18"
                        Background="{StaticResource AppSurfaceHighBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="120" Foreground="#26FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="CoverImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>
            </Viewbox>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="34" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" />
                <TextBlock x:Name="ArtistText" FontSize="{StaticResource SubtitleSize}" Foreground="{StaticResource AccentLightBrush}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="AlbumText" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextSecondaryBrush}"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>

            <Grid Grid.Row="2" x:Name="SeekRow" ColumnSpacing="16" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="PosText" Text="0:00" VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
                <Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="100" StepFrequency="1"
                        SmallChange="5" LargeChange="15" ValueChanged="Seek_ValueChanged"
                        Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" x:Name="DurText" Text="0:00" VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>

            <!-- Live radio has no seekable timeline; show a LIVE badge instead. -->
            <TextBlock Grid.Row="3" x:Name="LiveText" Text="&#x25CF;  LIVE" Visibility="Collapsed" HorizontalAlignment="Center"
                       Margin="0,8,0,0" FontSize="{StaticResource CaptionSize}" FontWeight="SemiBold" Foreground="{StaticResource LiveBrush}" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="ShuffleBtn" Style="{StaticResource IconButton}" Width="54" Height="54" CornerRadius="27"
                        VerticalAlignment="Center" FontSize="18" Content="&#xE8B1;" Click="Shuffle_Click" ToolTipService.ToolTip="Shuffle" />
                <Button x:Name="PrevBtn" Style="{StaticResource TransportButton}" Width="60" Height="60" CornerRadius="30"
                        VerticalAlignment="Center" FontSize="22" Content="&#xE892;" Click="Prev_Click" ToolTipService.ToolTip="Previous" />
                <Button x:Name="PlayBtn" Style="{StaticResource TransportButton}" Width="82" Height="82" CornerRadius="41"
                        VerticalAlignment="Center" FontSize="30" Background="{StaticResource AccentBrush}" Foreground="#06201E"
                        Click="PlayPause_Click" ToolTipService.ToolTip="Play / Pause" />
                <Button x:Name="NextBtn" Style="{StaticResource TransportButton}" Width="60" Height="60" CornerRadius="30"
                        VerticalAlignment="Center" FontSize="22" Content="&#xE893;" Click="Next_Click" ToolTipService.ToolTip="Next" />
                <Button x:Name="RepeatBtn" Style="{StaticResource IconButton}" Width="54" Height="54" CornerRadius="27"
                        VerticalAlignment="Center" FontSize="18" Click="Repeat_Click" ToolTipService.ToolTip="Repeat" />
            </StackPanel>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="22" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Button x:Name="StarBtn" Style="{StaticResource IconButton}" Width="50" Height="50" CornerRadius="25"
                        VerticalAlignment="Center" FontSize="18" Click="Star_Click" Foreground="{StaticResource AccentMagentaBrush}"
                        ToolTipService.ToolTip="Star" />
                <Button x:Name="QueueBtn" Style="{StaticResource IconButton}" Width="50" Height="50" CornerRadius="25"
                        VerticalAlignment="Center" FontSize="18" Content="&#xE90B;" Click="Queue_Click" ToolTipService.ToolTip="Queue" />
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="Collapsed">
            <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="#33FFFFFF" HorizontalAlignment="Center" />
            <TextBlock Text="Nothing playing" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="Pick an album, playlist, or song to start listening."
                       FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <Button Content="Browse albums" Style="{StaticResource PrimaryButton}" Click="Browse_Click"
                    HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</Page>
