<Page
    x:Class="NavidromeXbox.Views.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="56,28,40,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Grid Grid.Row="0" ColumnSpacing="28" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="240" Height="240" CornerRadius="16" Background="{StaticResource AppSurfaceHighBrush}">
                <Grid>
                    <TextBlock Text="&#xE93C;" FontFamily="Segoe MDL2 Assets" FontSize="56" Foreground="#33FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image x:Name="CoverImage" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                <TextBlock x:Name="TitleText" FontSize="{StaticResource DisplaySize}" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                <Button x:Name="ArtistButton" Style="{StaticResource IconButton}" Background="Transparent"
                        HorizontalContentAlignment="Left" Padding="2" Click="Artist_Click">
                    <TextBlock x:Name="ArtistText" FontSize="{StaticResource SubtitleSize}"
                               Foreground="{StaticResource AccentLightBrush}" FontFamily="Segoe UI" />
                </Button>
                <TextBlock x:Name="MetaText" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextSecondaryBrush}" />

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0">
                    <Button x:Name="PlayButton" Style="{StaticResource PrimaryButton}" Click="Play_Click" Padding="28,14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="Play" FontFamily="Segoe UI" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShuffleButton" Style="{StaticResource TileButton}" Click="Shuffle_Click" Padding="24,14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" />
                            <TextBlock Text="Shuffle" FontFamily="Segoe UI" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="QueueButton" Style="{StaticResource TileButton}" Click="Queue_Click" Padding="24,14"
                            ToolTipService.ToolTip="Add album to queue"
                            Content="&#xE710;" FontFamily="Segoe MDL2 Assets" />
                    <Button x:Name="StarButton" Style="{StaticResource TileButton}" Click="Star_Click" Padding="24,14"
                            ToolTipService.ToolTip="Star album"
                            Content="&#xEB51;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentMagentaBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Tracks -->
        <ListView Grid.Row="1" x:Name="SongList" IsItemClickEnabled="True" SelectionMode="None"
                  ItemClick="Song_Click" ItemTemplate="{StaticResource SongRowTemplate}" />

        <ProgressRing x:Name="Busy" Grid.Row="1" Width="44" Height="44" IsActive="True"
                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
