<Page
    x:Class="NavidromeXbox.Views.ArtistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="56,28,40,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Artists" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <!-- One flat, virtualized GridView: only the tiles on screen are realized, so even a
             library with thousands of artists scrolls smoothly without exhausting memory. -->
        <GridView x:Name="ArtistsGrid" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None"
                  ItemContainerStyle="{StaticResource AlbumTileGridItem}"
                  ItemClick="Artist_Click" ItemTemplate="{StaticResource ArtistTileTemplate}" Padding="0,0,0,8" />

        <ProgressRing x:Name="Busy" Grid.Row="1" Width="44" Height="44" IsActive="True"
                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="{StaticResource BodySize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" TextAlignment="Center" Margin="40" />
    </Grid>
</Page>
