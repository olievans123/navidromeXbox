<Page
    x:Class="NavidromeXbox.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="56,28,40,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Search" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search artists, albums, songs…"
                 FontSize="{StaticResource SubtitleSize}" TextChanged="Search_Changed" Margin="0,0,0,12" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="ArtistsSection" Visibility="Collapsed">
                    <TextBlock Text="Artists" FontSize="{StaticResource SubtitleSize}" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="2,8,0,10" />
                    <GridView x:Name="ArtistResults" IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="Artist_Click" ItemTemplate="{StaticResource ArtistTileTemplate}" />
                </StackPanel>

                <StackPanel x:Name="AlbumsSection" Visibility="Collapsed">
                    <TextBlock Text="Albums" FontSize="{StaticResource SubtitleSize}" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="2,8,0,10" />
                    <GridView x:Name="AlbumResults" IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="Album_Click" ItemTemplate="{StaticResource AlbumTileTemplate}" />
                </StackPanel>

                <StackPanel x:Name="SongsSection" Visibility="Collapsed">
                    <TextBlock Text="Songs" FontSize="{StaticResource SubtitleSize}" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="2,8,0,10" />
                    <ListView x:Name="SongResults" IsItemClickEnabled="True" SelectionMode="None"
                              ItemClick="Song_Click" ItemTemplate="{StaticResource SongRowTemplate}" />
                </StackPanel>

                <TextBlock x:Name="EmptyText" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="{StaticResource BodySize}" HorizontalAlignment="Center" Margin="0,60"
                           TextAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="Busy" Grid.Row="2" Width="36" Height="36" IsActive="False"
                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
    </Grid>
</Page>
