<Page
    x:Class="NavidromeXbox.Views.GenresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="56,28,40,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Genres" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Select a genre to start playing a shuffled mix."
                       FontSize="{StaticResource CaptionSize}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <GridView x:Name="Grid" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Genre_Click"
                  ItemTemplate="{StaticResource GenreTileTemplate}" Padding="0,0,0,8" />

        <ProgressRing x:Name="Busy" Grid.Row="1" Width="44" Height="44" IsActive="True"
                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="EmptyText" Grid.Row="1" Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="{StaticResource BodySize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" TextAlignment="Center" Margin="40" />
    </Grid>
</Page>
