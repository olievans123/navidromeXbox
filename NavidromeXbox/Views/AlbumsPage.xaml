<Page
    x:Class="NavidromeXbox.Views.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <Grid Padding="56,28,40,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Albums" FontSize="{StaticResource TitleSize}" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <ComboBox x:Name="SortBox" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="220"
                      Style="{StaticResource ThemedComboBox}" SelectionChanged="Sort_Changed">
                <ComboBoxItem Content="Recently added" Tag="newest" IsSelected="True" />
                <ComboBoxItem Content="Recently played" Tag="recent" />
                <ComboBoxItem Content="Most played" Tag="frequent" />
                <ComboBoxItem Content="By name" Tag="alphabeticalByName" />
                <ComboBoxItem Content="By artist" Tag="alphabeticalByArtist" />
                <ComboBoxItem Content="Starred" Tag="starred" />
                <ComboBoxItem Content="Random" Tag="random" />
            </ComboBox>
        </Grid>

        <!-- The GridView scrolls and virtualizes itself; the Load more button and the
             busy/empty states live in its footer so the controller can reach them. -->
        <GridView x:Name="Grid" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="Album_Click"
                  ItemContainerStyle="{StaticResource AlbumTileGridItem}"
                  ItemTemplate="{StaticResource AlbumTileTemplate}" Padding="0,0,0,8">
            <GridView.Footer>
                <StackPanel>
                    <Button x:Name="MoreButton" Style="{StaticResource TileButton}" Content="Load more"
                            HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,24"
                            Click="More_Click" Visibility="Collapsed" />
                    <ProgressRing x:Name="Busy" Width="40" Height="40" IsActive="False" Margin="0,30,0,30"
                                  Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="EmptyText" Text="No albums found." Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="{StaticResource BodySize}" HorizontalAlignment="Center" Margin="0,40"
                               Visibility="Collapsed" />
                </StackPanel>
            </GridView.Footer>
        </GridView>
    </Grid>
</Page>
